# Configuración de la Base de Datos
# Por defecto es 'cfdi_data.db' en la raíz del proyecto.
# Para producción en la nube (ej. Fly.io o Render con disco persistente), usar una ruta absoluta como /data/cfdi_data.db
DB_PATH=cfdi_data.db

# Entorno de Flask (development / production)
FLASK_ENV=development
